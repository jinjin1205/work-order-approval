{
  "name": "xgd-r05-20261026",
  "services": {
    "db": {
      "image": "mariadb:10.6",
      "environment": {
        "MARIADB_ROOT_PASSWORD": "${R05_DB_PASSWORD}"
      },
      "command": [
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci",
        "--skip-character-set-client-handshake"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "healthcheck.sh",
          "--connect",
          "--innodb_initialized"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20
      },
      "volumes": [
        "db-data:/var/lib/mysql"
      ]
    },
    "redis-cache": {
      "image": "redis:6.2-alpine"
    },
    "redis-queue": {
      "image": "redis:6.2-alpine",
      "volumes": [
        "redis-queue-data:/data"
      ]
    },
    "bench": {
      "image": "frappe/erpnext@sha256:4160d3c77aafb41c7770aad3daa67254a13f8750765ee83d632434ed564a4834",
      "working_dir": "/home/frappe/frappe-bench",
      "entrypoint": [],
      "environment": {
        "R05_DB_PASSWORD": "${R05_DB_PASSWORD}",
        "R05_ADMIN_PASSWORD": "${R05_ADMIN_PASSWORD}"
      },
      "volumes": [
        "sites:/home/frappe/frappe-bench/sites",
        "logs:/home/frappe/frappe-bench/logs",
        "./probes:/eval:ro"
      ]
    }
  },
  "volumes": {
    "db-data": {},
    "redis-queue-data": {},
    "sites": {},
    "logs": {}
  }
}
