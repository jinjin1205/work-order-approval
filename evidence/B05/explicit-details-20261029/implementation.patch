+			load(self.company, operation)
+
+	def test_no_rules_is_explicit(self):
+		self.assertEqual(self.loader()(self.company, None), [])
+
+	def test_native_chinese_translations(self):
+		for text, expected in (("Production Time Rule", "报工时段规则"),
