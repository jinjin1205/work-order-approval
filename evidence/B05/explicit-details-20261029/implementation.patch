+		result = calc("2026-10-20T01:00:00+00:00", "2026-10-20T09:00:00+00:00", rules=[self.rule()])
+		self.assertEqual(result["effective_seconds"], 25200)
+		result = calc("2026-10-20 09:00:00.200", "2026-10-20 09:00:02.100", rules=[])
