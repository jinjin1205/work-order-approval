+class TestBOMRequiredQuantity(FrappeTestCase):
+	"""Exact material demand through the existing BOM provider and stock documents."""
+
+	def setUp(self):
+		from erpnext.manufacturing.doctype.work_order.test_work_order import TestWorkOrderRequiredQuantity
+
+		frappe.set_user("Administrator")
