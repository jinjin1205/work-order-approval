+		self.order, self.raw, self.bom = TestWorkOrderRequiredQuantity.make_quantity_order(self, 0.5, 100, 2)
+
+	def clean_fixture(self):
+		frappe.db.rollback()
+		frappe.clear_cache()
+
+	def make_bom(self, item, raw, qty, base=1, loss=0):
+		from erpnext.manufacturing.doctype.production_plan.test_production_plan import make_bom
+
+		bom = make_bom(item=item, company=self.order.company,
+			currency=frappe.get_cached_value("Company", self.order.company, "default_currency"),
+			quantity=base, raw_materials=[raw], rm_qty=qty, rate=2,
+			source_warehouse=self.order.source_warehouse, with_operations=False, do_not_save=True)
+		bom.items[0].material_loss_percent = loss
+		return bom
+
+	def nested_bom(self, child_qty, parent_qty, child_base=1, child_loss=0, parent_loss=0):
+		from frappe.utils.nestedset import get_root_of
+
+		prefix = "B04-precision-" + frappe.generate_hash(length=8)
+		sub = make_item(prefix, {"item_group": get_root_of("Item Group"), "stock_uom": self.raw.stock_uom})
+		child = self.make_bom(sub.name, self.raw.name, child_qty, child_base, child_loss).insert().submit()
+		parent = self.make_bom(self.order.production_item, sub.name, parent_qty, loss=parent_loss).insert().submit()
+		self.assertEqual(parent.items[0].bom_no, child.name)
+		return parent
+
