+			card.submit()
+		card.reload()
+		self.assertEqual(card.docstatus, 0)
+		self.assertFalse(card.time_logs)
+
+	def test_approved_task_and_timer_allowed(self):
+		card = self.approve()
+		frappe.set_user(self.f.users["operator"])
