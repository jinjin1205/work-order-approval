+		workstation = make_workstation(workstation_name=self.prefix).name
+		self.operations = [
+			frappe.get_doc({"doctype": "Operation", "__newname": self.prefix + suffix}).insert().name
+			for suffix in ("-下料", "-检验")
+		]
+		self.orders = []
+		self.cards = []
+		for index in range(2):
+			order = make_wo_order_test_record(
