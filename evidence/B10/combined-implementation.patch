+	@change_settings("System Settings", {"float_precision": 6})
+	@change_settings("Manufacturing Settings", {"backflush_raw_materials_based_on": "BOM"})
+	def test_transfer_limit_uses_stock_uom(self):
+		# Expected amounts are independent constants in the work order's stock unit.
+		cases = [
+			("kg", 0.5, [(500, "g", 0.001)], False),
+			("kg", 0.5, [(600, "g", 0.001)], True),
+			("g", 500, [(0.6, "kg", 1000)], True),
+			("g", 500, [(0.5, "kg", 1000)], False),
+			("kg", 0.5, [(0.2, "kg", 1), (300, "g", 0.001)], False),
+			("kg", 0.5, [(0.2, "kg", 1), (400, "g", 0.001)], True),
+			("kg", 0.5, [(0.5, "kg", 1)], False),
+			("kg", 0.5, [(0.6, "kg", 1)], True),
+		]
+		for stock_uom, pending, rows, reject in cases:
+			with self.subTest(stock_uom=stock_uom, rows=rows):
+				order = frappe.new_doc("Work Order")
+				order.append("required_items", {"item_code": "B10-原料", "required_qty": pending})
+				entry = frappe.new_doc("Stock Entry")
+				entry.pro_doc = order
+				for qty, uom, factor in rows:
+					entry.append(
+						"items",
+						{
+							"item_code": "B10-原料",
+							"s_warehouse": "B10-原料仓",
+							"qty": qty,
+							"uom": uom,
+							"stock_uom": stock_uom,
+							"conversion_factor": factor,
+						},
+					)
+				entry.set_transfer_qty()
+				if reject:
+					with self.assertRaises(frappe.ValidationError):
+						entry._validate_no_excess_transfer()
+				else:
+					entry._validate_no_excess_transfer()
